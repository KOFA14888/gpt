# Скопируй этот файл в .env (run.bat сделает это сам) и вставь свои ключи.
# Ключи можно также ввести в интерфейсе: кнопка ⚙ -> поля API-ключ.

# https://openrouter.ai/keys — бесплатные модели помечаются как :free
OPENROUTER_API_KEY=

# https://build.nvidia.com/settings/api-keys — Free Endpoint models
NVIDIA_NIM_API_KEY=

# Необязательно: конкретные модели
# OPENROUTER_MODEL=google/gemma-4-31b-it:free
# NVIDIA_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b
